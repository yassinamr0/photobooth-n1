# Firebase web app config (Firebase console → Project settings → Your apps → SDK setup).
# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment
# Variables. These are client identifiers (not secrets); security comes from firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local testing only — connect to the Firebase emulators instead of the real project.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
