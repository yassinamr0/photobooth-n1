rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() && myDoc().data.role == 'admin' && myDoc().data.approved == true;
    }
    // Current pack size (settings/paper.sheetsPerPack), default 18 when the doc doesn't exist.
    // PACK — never the box size (sheetsPerBox), which is only for inventory restocks.
    function paperSettingsPath() {
      return /databases/$(database)/documents/settings/paper;
    }
    function packSizeMatchesSettings(v) {
      return (!exists(paperSettingsPath()) && v == 18)
          || (exists(paperSettingsPath()) && v == get(paperSettingsPath()).data.get('sheetsPerPack', 18));
    }

    function shiftPath(id) {
      return /databases/$(database)/documents/shifts/$(id);
    }

    // Any approved user (staff or admin). Pending signups are NOT approved.
    function isApproved() {
      return isSignedIn() && myDoc().data.approved == true;
    }

    // /users/{uid} — Booth Log rebuild (Phase 2).
    // - Any signed-in user can read profiles (names resolve across the app).
    // - You can create only your OWN doc, only as unapproved staff with no assigned event.
    // - You can edit your own doc, but never your own role, approved, assignedEventId or uid.
    //   (diff().affectedKeys() is used instead of field == field so legacy docs that lack
    //   assignedEventId still allow harmless self-edits, and the field can't be added either.)
    // - Only an approved admin can change those fields or delete a user doc.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'staff'
                    && request.resource.data.approved == false
                    && request.resource.data.get('assignedEventId', null) == null;
      allow update: if isAdmin() || (
                      isSignedIn() && request.auth.uid == userId
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'approved', 'assignedEventId', 'uid'])
                    );
      allow delete: if isAdmin();
    }

    // /shifts/{id} — Booth Log rebuild (Phase 3). Shared with the legacy app (same shape).
    // - Read: approved users only (a pending signup must not see sales data).
    // - Create: only as yourself, and eventId must be the ONE-TIME SNAPSHOT of your own
    //   assignedEventId at this moment (missing/null on both sides = no event, which is what
    //   legacy-app shifts look like). paperVerified can't be pre-set.
    // - Update: admin always; staff only their own shift and never uid / eventId /
    //   paperVerified / createdAt / sheetsPerPack / stockDeduction (eventId is never re-derived;
    //   paperVerified is admin's call; stockDeduction only via the narrow Phase 5 branch).
    // - Delete: admin only (deleting a shift would orphan its entries).
    match /shifts/{shiftId} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.get('eventId', null)
                         == myDoc().data.get('assignedEventId', null)
                    && request.resource.data.get('paperVerified', false) == false
                    // Pack-size snapshot (Phase 4): if present it must be the current setting.
                    // Absent is allowed (legacy app) — reconciliation then uses the setting.
                    && (request.resource.data.get('sheetsPerPack', null) == null
                        || packSizeMatchesSettings(request.resource.data.sheetsPerPack))
                    && request.resource.data.get('stockDeduction', null) == null
                    && request.resource.data.get('stockExempt', false) == false
                    && request.resource.data.get('inkChanges', 0) == 0;
      allow update: if isAdmin()
                    || (
                      isApproved() && resource.data.uid == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['uid', 'eventId', 'paperVerified', 'createdAt', 'sheetsPerPack', 'stockDeduction', 'stockExempt'])
                      // once deducted from stock, the shift is frozen for staff
                      && resource.data.get('stockDeduction', null) == null
                      && request.resource.data.get('inkChanges', 0) is int
                      && request.resource.data.get('inkChanges', 0) >= 0
                    )
                    // Automatic stock consumption, staff side (paper, ink, frames). Only the owner,
                    // only after the shift has ended, only once, only into the shift's OWN eventId,
                    // never for a stock-exempt shift, and only together with one stock log per
                    // type that was taken (fixed ids). Each log's own rule checks the matching
                    // stock went down by exactly that amount (see isValidStockDeduction), so a
                    // shift mark can't be written without the stock updates and vice versa.
                    // (Checks are split this way to stay under Firestore's 10-lookup limit.)
                    || (
                      isApproved() && resource.data.uid == request.auth.uid
                      && resource.data.get('endTime', null) != null
                      && resource.data.get('eventId', null) != null
                      && resource.data.get('stockDeduction', null) == null
                      && resource.data.get('stockExempt', false) != true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockDeduction'])
                      && isValidDeductionShape(request.resource.data.stockDeduction, resource.data)
                      && existsAfter(stockLogPath(resource.data.eventId, 'shift_' + shiftId))
                      && (request.resource.data.stockDeduction.get('cartridges', 0) == 0
                          || existsAfter(stockLogPath(resource.data.eventId, 'shiftink_' + shiftId)))
                      && (request.resource.data.stockDeduction.get('acrylic', 0) == 0
                          || existsAfter(stockLogPath(resource.data.eventId, 'shiftacr_' + shiftId)))
                      && (request.resource.data.stockDeduction.get('magnetic', 0) == 0
                          || existsAfter(stockLogPath(resource.data.eventId, 'shiftmag_' + shiftId)))
                    );
      allow delete: if isAdmin();
    }

    // /entries/{id} — sales + waste. Shared with the legacy app.
    // - Read: approved users only.
    // - Create: only as yourself, and only into one of your OWN shifts.
    // - Update/delete: admin always; staff only their own entries, and an update can never
    //   move an entry to another user or shift.
    match /entries/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved()
                    && request.resource.data.uid == request.auth.uid
                    && get(shiftPath(request.resource.data.shiftId)).data.uid == request.auth.uid
                    && get(shiftPath(request.resource.data.shiftId)).data.get('stockDeduction', null) == null;
      // Once a shift's paper has been deducted from stock (Phase 5), its entries are frozen for
      // staff so stock and sales can't drift apart. Admins can still correct anything.
      allow update: if isAdmin() || (
                      isApproved() && resource.data.uid == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['uid', 'shiftId', 'createdAt'])
                      && get(shiftPath(resource.data.shiftId)).data.get('stockDeduction', null) == null
                    );
      allow delete: if isAdmin() || (
                      isApproved() && resource.data.uid == request.auth.uid
                      && get(shiftPath(resource.data.shiftId)).data.get('stockDeduction', null) == null
                    );
    }

    // /events/{id} — booth locations (Phase 5). Readable by any approved user, writable only
    // by admins (staff never see events in the UI — it's admin bookkeeping).
    match /events/{eventId} {
      allow read: if isApproved();
      allow write: if isAdmin();

      // Per-event stock: paper (in SHEETS), ink (cartridges), acrylic + magnetic frames
      // (pieces). Admin writes everything (restocks — paper in BOXES → sheets — corrections,
      // thresholds, "mark as read" on low-stock alerts). The ONLY staff write is the automatic
      // shift-end deduction, checked against the shift in the same batch; staff can never
      // touch the threshold or alertDismissed.
      match /stock/{stockType} {
        allow read: if isApproved();
        allow write: if isAdmin();
        allow update: if isApproved()
                      && stockType in ['paper', 'ink', 'acrylic', 'magnetic']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['currentQuantity', 'updatedAt', 'lastShiftId'])
                      && isValidStockDeduction(eventId, request.resource.data.lastShiftId, stockType,
                           resource.data.currentQuantity - request.resource.data.currentQuantity);
      }

      match /stockLogs/{logId} {
        allow read: if isApproved();
        allow create, update, delete: if isAdmin();
        // Staff: at most one log per stock type per shift, with a fixed id
        // (shift_ / shiftink_ / shiftacr_ / shiftmag_ + shiftId), matching the deduction.
        allow create: if isApproved()
                      && request.resource.data.kind == 'shift'
                      && request.resource.data.stockType in ['paper', 'ink', 'acrylic', 'magnetic']
                      && logId == shiftLogPrefix()[request.resource.data.stockType] + request.resource.data.shiftId
                      && request.resource.data.byUid == request.auth.uid
                      && isValidStockDeduction(eventId, request.resource.data.shiftId,
                           request.resource.data.stockType, -request.resource.data.delta);
      }
    }

    function stockLogPath(eventId, logId) {
      return /databases/$(database)/documents/events/$(eventId)/stockLogs/$(logId);
    }
    function shiftLogPrefix() {
      return { 'paper': 'shift_', 'ink': 'shiftink_', 'acrylic': 'shiftacr_', 'magnetic': 'shiftmag_' };
    }
    // Field on shift.stockDeduction holding each stock type's amount.
    function deductionField() {
      return { 'paper': 'sheets', 'ink': 'cartridges', 'acrylic': 'acrylic', 'magnetic': 'magnetic' };
    }

    // The stockDeduction map a staff member writes on their own shift (no lookups).
    // Ink must be exactly the cartridges they logged on this shift ("+ Ink change").
    function isValidDeductionShape(sd, shift) {
      return sd.keys().hasOnly(['eventId', 'sheets', 'cartridges', 'acrylic', 'magnetic'])
          && sd.eventId == shift.eventId
          && sd.sheets is number && sd.sheets >= 0
          && sd.get('cartridges', 0) == shift.get('inkChanges', 0)
          && sd.get('acrylic', 0) is int && sd.get('acrylic', 0) >= 0
          && sd.get('magnetic', 0) is int && sd.get('magnetic', 0) >= 0;
    }

    // A staff deduction for ONE stock type is valid only if, in the SAME batch
    // (get = before, getAfter = after):
    //  - the shift belongs to the caller, was stamped with THIS event, had ended, isn't
    //    stock-exempt, and had no deduction before — and records exactly `amount` of this
    //    type after (ink: also equal to the shift's own inkChanges);
    //  - THIS event's stock of this type went down by exactly `amount`, tagged with the shift.
    // Paper is always written (may be 0); other types only when above 0.
    function isValidStockDeduction(eventId, shiftId, stockType, amount) {
      let before = get(shiftPath(shiftId)).data;
      let after = getAfter(shiftPath(shiftId)).data;
      let stockPath = /databases/$(database)/documents/events/$(eventId)/stock/$(stockType);
      return before.uid == request.auth.uid
          && before.get('eventId', null) == eventId
          && before.get('endTime', null) != null
          && before.get('stockDeduction', null) == null
          && before.get('stockExempt', false) != true
          && (stockType == 'paper' || amount > 0)
          && (stockType != 'ink' || before.get('inkChanges', 0) == amount)
          && after.get('stockDeduction', null) != null
          && after.stockDeduction.eventId == eventId
          && after.stockDeduction.get(deductionField()[stockType], 0) == amount
          && getAfter(stockPath).data.get('lastShiftId', null) == shiftId
          && get(stockPath).data.currentQuantity - getAfter(stockPath).data.currentQuantity == amount;
    }

    // /settings/{doc} — e.g. settings/paper { sheetsPerPack, sheetsPerBox }.
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
